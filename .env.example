# Copy to .env. Answers and embeddings run locally on Ollama (`make models`).
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Any OpenAI-compatible endpoint with tool calling: Ollama, Gemini, NVIDIA NIM, OpenAI.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5-4b-8k
LLM_REASONING_EFFORT=none

EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=
EMBED_MODEL=bge-m3

# USD per million tokens for the answer model, used for cost-per-query in eval summaries.
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0

# The judge runs on Gemini, a different model family from the answer model. Key: aistudio.google.com
JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
JUDGE_API_KEY=
JUDGE_MODEL=gemini-3.6-flash
JUDGE_RPM=8
